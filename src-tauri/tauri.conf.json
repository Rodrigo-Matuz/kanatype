{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "KanataType",
	"version": "1.0.0",
	"identifier": "me.matuz.kanatype",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "KanataType",
				"width": 800,
				"height": 600,
				"decorations": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "Education",
		"shortDescription": "Practice Japanese kana and kanji with instant feedback",
		"longDescription": "Learn hiragana, katakana, and kanji through focused typing practice and a searchable character reference.",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
